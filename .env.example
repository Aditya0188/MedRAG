# ==============================================================================
# MedDRAG System Configuration Template
# Generative AI-Based Medical Document Analysis and Information Retrieval System
# ==============================================================================

# Application Execution Mode: "demo" (default) or "live"
# - In "demo" mode: Uses synthetic outpatient prescriptions with deterministic RxNorm/FDA fixtures.
# - In "live" mode: Calls official Google GenAI Gemini multimodal vision API & live NLM/FDA endpoints.
APP_MODE=demo

# Google Gemini Vision Configuration (Required only for live mode)
# Obtain key from: https://aistudio.google.com/
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash
EMBEDDING_MODEL=text-embedding-004

# Database Configuration (Defaults to local SQLite)
DATABASE_URL=sqlite:///./data/meddrag.db

# Qdrant Vector Engine Configuration
# Leave QDRANT_URL empty to use the built-in embedded local disk vector engine
QDRANT_URL=
QDRANT_PATH=./data/qdrant

# File Storage & Limits
UPLOAD_DIR=./data/uploads
SAMPLES_DIR=./data/samples
MAX_UPLOAD_SIZE_MB=15

# CORS Allowed Origins (Comma-separated for FastAPI)
CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000

# Frontend Next.js Public Backend Endpoint
NEXT_PUBLIC_API_URL=http://localhost:8000/api/v1
